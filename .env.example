# ─── Database ─────────────────────────────────────────────────
# Local SQLite (dev):
# DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/edupro?schema=public"

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Edupro"
NODE_ENV="development"

# ─── Auth (Auth.js / NextAuth v5) ─────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"

# ─── Multi-tenancy ────────────────────────────────────────────
ROOT_DOMAIN="localhost:3000"
# Production: edupro.app → {slug}.edupro.app

# ─── Payment Gateways (optional) ──────────────────────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""

# ─── SMS Gateway (optional) ───────────────────────────────────
SMS_API_KEY=""
SMS_SENDER_ID=""

# ─── Docker build flag (set automatically in Dockerfile) ──────
# DOCKER_BUILD=1
