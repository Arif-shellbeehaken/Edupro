# ─── Database ─────────────────────────────────────────────────
# Local SQLite (dev):
# DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/edupro?schema=public&connection_limit=10&pool_timeout=20"
# Optional read replica (reporting / heavy reads):
# DATABASE_URL_READ="postgresql://user:password@read-replica:5432/edupro?schema=public&connection_limit=20"

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Edupro"
NODE_ENV="development"

# ─── Auth (Auth.js / NextAuth v5) ─────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Multi-tenancy ────────────────────────────────────────────
ROOT_DOMAIN="localhost:3000"
# Production: edupro.app → {slug}.edupro.app

# ─── Payment Gateways ─────────────────────────────────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
# Sandbox: tokenized.sandbox.bka.sh — Live: tokenized.pay.bka.sh
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# ─── SMS Gateway ──────────────────────────────────────────────
# console (default) | sslwireless | http
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID="EDUPRO"
SMS_API_ENDPOINT="https://sms.example.com/api/v3/send-sms"

# ─── Email (optional transactional) ───────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@edupro.app"

# ─── Storage / CDN (optional) ─────────────────────────────────
# S3-compatible for certificates, ID cards, logos
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# ─── Feature flags ────────────────────────────────────────────
FEATURE_2FA_ENFORCE="false"
FEATURE_SMS_LIVE="false"
FEATURE_BKASH_LIVE="false"

# ─── Observability ────────────────────────────────────────────
LOG_LEVEL="info"
# SENTRY_DSN=""

# ─── Docker build flag (set automatically in Dockerfile) ──────
# DOCKER_BUILD=1

# REDIS_URL="redis://localhost:6379"

# ─── Rate limit (optional Upstash Redis) ──────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cron / retention ─────────────────────────────────────────
CRON_SECRET="generate-long-random-cron-secret"
RETENTION_AUDIT_DAYS="730"
RETENTION_MESSAGE_DAYS="180"
RETENTION_SOFT_DELETE_DAYS="365"
# RETENTION_HARD_DELETE="true"

# Rocket (DBBL) payment
ROCKET_MODE="sandbox"
ROCKET_MERCHANT_ID=""
ROCKET_SECRET=""
