// Edupro — Production Prisma Schema
// Multi-tenant Shared Database + tenant_id isolation
// Strategy: Shared DB + strict tenant_id filtering + future RLS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local/dev: sqlite | Production: postgresql
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// ═══════════════════════════════════════════════════════════════
// TENANCY & PLATFORM
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id                    String    @id @default(cuid())
  name                  String
  nameBn                String?
  slug                  String    @unique          // subdomain key
  type                  String                    // InstitutionType enum
  status                String    @default("TRIAL")
  plan                  String    @default("BASIC")

  logoUrl               String?
  primaryColor          String?   @default("#059669")
  secondaryColor        String?

  email                 String?
  phone                 String?
  address               String?
  district              String?
  division              String?

  academicYearStartMonth Int?     @default(1)
  boardAffiliation      String    @default("[]")  // JSON array as string for SQLite; use String[] on PostgreSQL


  maxStudents           Int       @default(500)
  maxStaff              Int       @default(50)

  trialEndsAt           DateTime?
  subscriptionEndsAt    DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  // Relations
  users                 User[]
  students              Student[]
  academicYears         AcademicYear[]
  classes               Class[]
  hifzProgress          HifzProgress[]
  hifzEntries           HifzEntry[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  auditLogs             AuditLog[]

  @@index([status])
  @@index([slug])
  @@map("tenants")
}

model SubscriptionPlanConfig {
  id              String   @id @default(cuid())
  code            String   @unique          // BASIC, STANDARD, PREMIUM, ENTERPRISE
  name            String
  nameBn          String?
  priceMonthly    Int                       // in BDT (paisa or full taka)
  priceYearly     Int?
  maxStudents     Int
  maxStaff        Int
  features        Json                      // feature flags
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscription_plan_configs")
}

// ═══════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════════

model User {
  id                String    @id @default(cuid())
  tenantId          String?                       // null = SUPER_ADMIN
  email             String
  phone             String?
  passwordHash      String

  name              String
  nameBn            String?
  avatarUrl         String?

  role              String                        // UserRole enum
  isActive          Boolean   @default(true)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  hifzEntriesAsTeacher HifzEntry[] @relation("HifzTeacher")
  auditLogs         AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// ACADEMIC CORE
// ═══════════════════════════════════════════════════════════════

model AcademicYear {
  id          String    @id @default(cuid())
  tenantId    String
  name        String                        // "2025-2026"
  nameBn      String?
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  classes     Class[]
  students    Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_years")
}

model Class {
  id              String    @id @default(cuid())
  tenantId        String
  academicYearId  String
  name            String                        // "Dakhil 1st", "Hifz Group A"
  nameBn          String?
  nameAr          String?
  code            String?                       // internal code
  capacity        Int?
  sortOrder       Int       @default(0)

  // Board mapping
  board           String?                       // BMEB / BEFAQ / GENERAL
  level           String?                       // Dakhil, Alim, Hifz, etc.

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  sections        Section[]
  students        Student[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@map("classes")
}

model Section {
  id          String    @id @default(cuid())
  tenantId    String
  classId     String
  name        String                        // "A", "B", "Morning"
  capacity    Int?
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class       Class     @relation(fields: [classId], references: [id])
  students    Student[]

  @@unique([classId, name])
  @@index([tenantId])
  @@map("sections")
}

model Student {
  id                  String    @id @default(cuid())
  tenantId            String
  studentId           String                        // institution generated ID
  rollNumber          String?

  name                String
  nameBn              String?
  nameAr              String?
  dateOfBirth         DateTime?
  gender              String
  bloodGroup          String?
  photoUrl            String?

  currentClassId      String?
  currentSectionId    String?
  academicYearId      String?
  status              String    @default("ACTIVE")
  admissionDate       DateTime?

  fatherName          String?
  fatherNameBn        String?
  fatherPhone         String?
  fatherNid           String?
  motherName          String?
  motherNameBn        String?
  motherPhone         String?
  guardianName        String?
  guardianPhone       String?
  guardianRelation    String?

  presentAddress      String?
  permanentAddress    String?
  birthCertificateNo  String?
  nid                 String?

  allergies           String?
  chronicConditions   String?

  isHifzStudent       Boolean   @default(false)
  currentJuz          Int?
  currentPage         Int?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  currentClass        Class?    @relation(fields: [currentClassId], references: [id])
  currentSection      Section?  @relation(fields: [currentSectionId], references: [id])
  academicYear        AcademicYear? @relation(fields: [academicYearId], references: [id])
  hifzProgress        HifzProgress?
  hifzEntries         HifzEntry[]
  invoices            Invoice[]
  attendances         Attendance[]

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, currentClassId])
  @@map("students")
}

// ═══════════════════════════════════════════════════════════════
// ATTENDANCE
// ═══════════════════════════════════════════════════════════════

model Attendance {
  id          String    @id @default(cuid())
  tenantId    String
  studentId   String
  date        DateTime
  status      String    // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY
  period      String    @default("") // period-wise; empty = daily
  remarks     String?
  markedById  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     Student   @relation(fields: [studentId], references: [id])

  @@unique([tenantId, studentId, date, period])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("attendances")
}


// ═══════════════════════════════════════════════════════════════
// HIFZ (KEY DIFFERENTIATOR)
// ═══════════════════════════════════════════════════════════════


model HifzProgress {
  id                  String    @id @default(cuid())
  tenantId            String
  studentId           String    @unique

  totalJuzCompleted   Int       @default(0)
  totalPagesMemorized Int       @default(0)
  currentJuz          Int       @default(1)
  currentPage         Int       @default(1)
  currentSurah        String?
  averageQualityScore Float     @default(0)
  lastEntryDate       DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  student             Student   @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@map("hifz_progress")
}

model HifzEntry {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  teacherId       String

  date            DateTime
  stream          String                        // SABAK | SABKI | MANZIL


  fromJuz         Int
  fromPage        Int
  fromSurah       String?
  fromAyah        Int?

  toJuz           Int
  toPage          Int
  toSurah         String?
  toAyah          Int?

  quality         String                        // TilawatQuality
  mistakesCount   Int?
  teacherNote     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  student         Student   @relation(fields: [studentId], references: [id])
  teacher         User      @relation("HifzTeacher", fields: [teacherId], references: [id])

  @@index([tenantId, studentId, date])
  @@index([tenantId, teacherId, date])
  @@index([tenantId, stream, date])
  @@map("hifz_entries")
}

// ═══════════════════════════════════════════════════════════════
// FINANCE (Core)
// ═══════════════════════════════════════════════════════════════

model FeeStructure {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  nameBn      String?
  feeType     String                        // FeeType enum
  amount      Int                           // in BDT (smallest unit or full)
  classId     String?                       // null = applies to all
  isRecurring Boolean   @default(true)
  dueDay      Int?                          // day of month
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("fee_structures")
}

model Invoice {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  invoiceNumber   String
  status          String    @default("ISSUED")

  issueDate       DateTime  @default(now())
  dueDate         DateTime
  totalAmount     Int
  paidAmount      Int       @default(0)
  discountAmount  Int       @default(0)
  fineAmount      Int       @default(0)
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  student         Student   @relation(fields: [studentId], references: [id])
  payments        Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Payment {
  id              String    @id @default(cuid())
  tenantId        String
  invoiceId       String
  amount          Int
  method          String                        // PaymentMethod
  status          String    @default("COMPLETED")
  transactionId   String?                       // bKash/Nagad trxID
  paidAt          DateTime  @default(now())
  notes           String?
  receivedById    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice         Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════
// EXAM & RESULT
// ═══════════════════════════════════════════════════════════════

model Subject {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  nameBn      String?
  code        String?
  fullMarks   Int       @default(100)
  passMarks   Int       @default(33)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  examMarks   ExamMark[]
  timetableSlots TimetableSlot[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

model Exam {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  nameBn          String?
  examType        String    // CLASS_TEST | MID_TERM | FINAL | BOARD | HIFZ_TEST
  academicYearId  String?
  startDate       DateTime?
  endDate         DateTime?
  isPublished     Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  marks           ExamMark[]

  @@index([tenantId])
  @@map("exams")
}

model ExamMark {
  id          String    @id @default(cuid())
  tenantId    String
  examId      String
  studentId   String
  subjectId   String
  marksObtained Float
  fullMarks   Float     @default(100)
  grade       String?
  remarks     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exam        Exam      @relation(fields: [examId], references: [id])
  subject     Subject   @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([tenantId, examId])
  @@index([tenantId, studentId])
  @@map("exam_marks")
}

// ═══════════════════════════════════════════════════════════════
// TIMETABLE
// ═══════════════════════════════════════════════════════════════

model TimetableSlot {
  id          String    @id @default(cuid())
  tenantId    String
  classId     String    @default("") // empty = general / all
  dayOfWeek   Int       // 0=Sunday ... 6=Saturday
  periodNo    Int
  startTime   String    // "09:00"
  endTime     String    // "09:45"
  subjectId   String?
  teacherId   String?
  room        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject     Subject?  @relation(fields: [subjectId], references: [id])

  @@unique([tenantId, classId, dayOfWeek, periodNo])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("timetable_slots")
}

// ═══════════════════════════════════════════════════════════════
// HR & PAYROLL
// ═══════════════════════════════════════════════════════════════

model Staff {
  id              String    @id @default(cuid())
  tenantId        String
  employeeId      String                        // institution staff code
  userId          String?                       // optional link to User login

  name            String
  nameBn          String?
  email           String?
  phone           String?
  gender          String?
  dateOfBirth     DateTime?
  nid             String?
  photoUrl        String?

  designation     String                        // Teacher, Accountant, Clerk...
  department      String?
  roleType        String    @default("TEACHER") // TEACHER | HIFZ_TEACHER | ACCOUNTANT | ADMIN | SUPPORT
  joiningDate     DateTime?
  employmentType  String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT
  status          String    @default("ACTIVE")  // ACTIVE | INACTIVE | TERMINATED | ON_LEAVE

  basicSalary     Int       @default(0)         // BDT
  houseRent       Int       @default(0)
  medicalAllow    Int       @default(0)
  otherAllow      Int       @default(0)
  bankName        String?
  bankAccount     String?

  address         String?
  emergencyContact String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  leaveRequests   LeaveRequest[]
  salaryPayments  SalaryPayment[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("staff")
}

model LeaveRequest {
  id            String    @id @default(cuid())
  tenantId      String
  staffId       String

  leaveType     String    // CASUAL | SICK | EARNED | UNPAID | MATERNITY | OTHER
  startDate     DateTime
  endDate       DateTime
  days          Float
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff     @relation(fields: [staffId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, staffId])
  @@map("leave_requests")
}

model PayrollRun {
  id            String    @id @default(cuid())
  tenantId      String
  month         Int       // 1-12
  year          Int
  status        String    @default("DRAFT") // DRAFT | PROCESSED | PAID
  processedAt   DateTime?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments      SalaryPayment[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@map("payroll_runs")
}

model SalaryPayment {
  id              String    @id @default(cuid())
  tenantId        String
  payrollRunId    String
  staffId         String

  basicSalary     Int
  houseRent       Int       @default(0)
  medicalAllow    Int       @default(0)
  otherAllow      Int       @default(0)
  grossSalary     Int
  deduction       Int       @default(0)   // leave without pay, advance, etc.
  netSalary       Int
  status          String    @default("PENDING") // PENDING | PAID
  paidAt          DateTime?
  paymentMethod   String?   // CASH | BANK | BKASH | NAGAD
  transactionId   String?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id])
  staff           Staff      @relation(fields: [staffId], references: [id])

  @@unique([payrollRunId, staffId])
  @@index([tenantId])
  @@index([tenantId, staffId])
  @@map("salary_payments")
}

// ═══════════════════════════════════════════════════════════════
// AUDIT & SYSTEM
// ═══════════════════════════════════════════════════════════════

model AuditLog {

  id          String    @id @default(cuid())
  tenantId    String?
  userId      String?
  action      String                        // CREATE, UPDATE, DELETE, LOGIN...
  entityType  String?                       // Student, Invoice, etc.
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
